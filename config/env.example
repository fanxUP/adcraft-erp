APP_NAME=AdCraft ERP
APP_ENV=production
# 首次启动前设置一个随机、唯一的初始管理员密码；留空则不会自动创建管理员。
ADMIN_INIT_PASSWORD=
SECRET_KEY=

POSTGRES_DB=adcraft_erp
POSTGRES_USER=adcraft
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://adcraft@postgres:5432/adcraft_erp
DATABASE_URL_SYNC=postgresql+psycopg://adcraft@postgres:5432/adcraft_erp

REDIS_URL=redis://redis:6379/0

MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=adcraft-files

UPLOAD_STORAGE=local
LOCAL_UPLOAD_DIR=/app/uploads

JWT_EXPIRE_MINUTES=1440

LAN_BASE_URL=http://192.168.1.10
