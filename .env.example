# AdCraft ERP — Environment Configuration
# Copy this file to .env and fill in the values:
#   cp .env.example .env

# ── App ─────────────────────────────────────────────────────────────
APP_NAME=AdCraft ERP
APP_ENV=development
# Generate with: openssl rand -hex 32; set before starting the application.
SECRET_KEY=
# 首次启动前设置一个随机、唯一的初始管理员密码；留空则不会自动创建管理员。
ADMIN_INIT_PASSWORD=
ALLOWED_ORIGINS=http://localhost:5173

# ── PostgreSQL ──────────────────────────────────────────────────────
POSTGRES_DB=adcraft_erp
POSTGRES_USER=adcraft
POSTGRES_PASSWORD=
# Local dev: 127.0.0.1  |  Docker: postgres (service name)
DATABASE_URL=postgresql+asyncpg://adcraft@127.0.0.1:5432/adcraft_erp
DATABASE_URL_SYNC=postgresql+psycopg2://adcraft@127.0.0.1:5432/adcraft_erp

# ── Redis ───────────────────────────────────────────────────────────
# Local dev: 127.0.0.1  |  Docker: redis (service name)
REDIS_URL=redis://127.0.0.1:6379/0

# ── MinIO (Object Storage, optional) ────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=adcraft-files

# ── Upload ──────────────────────────────────────────────────────────
UPLOAD_STORAGE=local
# Local dev: ./uploads  |  Docker: /app/uploads
LOCAL_UPLOAD_DIR=./uploads

# ── JWT ─────────────────────────────────────────────────────────────
JWT_EXPIRE_MINUTES=1440

# ── AI Features (all optional, disabled by default) ─────────────────
# AI_ENABLED=true
# AI_PROVIDER=anthropic
# AI_API_KEY=sk-ant-...
# AI_API_BASE_URL=
# AI_MODEL=claude-sonnet-4-20250514

# ── LAN Access ──────────────────────────────────────────────────────
LAN_BASE_URL=http://localhost
