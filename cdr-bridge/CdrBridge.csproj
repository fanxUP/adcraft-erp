<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AdCraftCdrBridge</AssemblyName>
    <RootNamespace>AdCraft.CdrBridge</RootNamespace>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <Title>AdCraft CDR Bridge</Title>
    <Description>AdCraft ERP CDR 智能报价本地桥接服务</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.*" />
  </ItemGroup>
</Project>
